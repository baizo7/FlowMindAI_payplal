# Copy this file to .env and fill in real values. Never commit the real .env.

# --- PayPal Sandbox ---
# Create a sandbox app at https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=http://localhost:8000/payment-complete
PAYPAL_CANCEL_URL=http://localhost:8000/payment-cancelled

# --- Gemini ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- App ---
DATABASE_URL=sqlite:///./flowmind.db
APP_SECRET=change-me
DEFAULT_CURRENCY=USD
